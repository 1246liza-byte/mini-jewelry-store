# ============================================
# Rosé & Gold — Frontend Environment Variables
# Copy this file to client/.env and fill in your values.
# WARNING: Anything in VITE_ variables is PUBLIC. Never put secrets here.
# ============================================

# Full URL to your backend API (including /api)
# Local development: http://localhost:5000/api
#
# ON VERCEL: Leave this commented out (or empty). The client and server share
# the same domain, so the app uses the relative '/api' path and Vercel's
# rewrite routes it to the server service automatically.
#
# Production example (if using a separate backend host):
# VITE_API_URL=https://your-backend-host.com/api
# VITE_API_URL=http://localhost:5000/api
#
# NOTE: Do NOT add any VITE_* variables on Vercel. The backend reads its own
# environment variables (MONGODB_URI, JWT_SECRET, CLOUDINARY_*, etc.) directly
# from the Vercel project settings — those are NOT exposed to the browser.