# ============================================
# Rosé & Gold — Environment Variables Example
# Copy this file to server/.env and fill in your real values.
# NEVER commit real secrets to GitHub.
# ============================================

# --- MongoDB Atlas ---
# Get this from your MongoDB Atlas cluster (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rose-gold?retryWrites=true&w=majority

# --- JWT Authentication ---
# Use a long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# --- Cloudinary (for image uploads) ---
# Get these from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Frontend URL (for CORS) ---
# In production, set this to your deployed frontend URL, e.g. https://rose-gold.vercel.app
CLIENT_URL=http://localhost:3000

# --- Admin Credentials (seeded on first run) ---
# The admin user is ONLY created if BOTH ADMIN_EMAIL and ADMIN_PASSWORD are set.
# There are NO default/hardcoded admin credentials. Set your own real values.
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password
ADMIN_NAME=Admin
ADMIN_PHONE=

# ============================================
# VERCEL DEPLOYMENT NOTES
# ============================================
# This project is a Vercel MONOREPO: the frontend (client/) and backend
# (server/) are deployed together from a single GitHub repo using vercel.json.
#
# In the Vercel dashboard, add ALL of the following as Environment Variables
# (they are read by the backend serverless function at runtime):
#
#   MONGODB_URI            your MongoDB Atlas connection string
#   JWT_SECRET             a long random string (generate with node crypto)
#   JWT_EXPIRES_IN         7d
#   CLOUDINARY_CLOUD_NAME  your Cloudinary cloud name
#   CLOUDINARY_API_KEY     your Cloudinary API key
#   CLOUDINARY_API_SECRET  your Cloudinary API secret
#   CLIENT_URL             your deployed frontend URL, e.g. https://rose-gold.vercel.app
#   ADMIN_EMAIL            admin login email (REQUIRED to create the admin user)
#   ADMIN_PASSWORD         admin login password (REQUIRED to create the admin user)
#   ADMIN_NAME             (optional) admin display name
#   ADMIN_PHONE            (optional) admin phone number
#
# NOTE: No admin user is created unless BOTH ADMIN_EMAIL and ADMIN_PASSWORD are
# set. There are no default/hardcoded admin credentials. No sample products are
# seeded — the store starts empty and you add products via the admin dashboard.
#
# The client uses a relative '/api' path on Vercel (no VITE_API_URL needed).
# The server service's entrypoint is server/api/index.js.
#
# IMPORTANT: On Vercel, image uploads REQUIRE Cloudinary. The local disk
# fallback is disabled because Vercel's filesystem is read-only/ephemeral.